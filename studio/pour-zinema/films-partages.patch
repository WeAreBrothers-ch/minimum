+++ b/sanity/partage/ArriveeDesFilms.tsx
@@ -0,0 +1,81 @@
+/**
+ * L'arrivée automatique des films de l'autre cinéma.
+ *
+ * Posée autour de tout le Studio (sanity.config.ts) : dès qu'on l'ouvre,
+ * puis toutes les cinq minutes, les films publiés chez l'autre et absents
+ * d'ici sont créés ici, fiche et affiche copiées, et les corrections faites
+ * là-bas sont reprises ici (si la fiche d'ici n'a pas été modifiée entre
+ * temps). Personne n'a rien à faire. Un mot s'affiche quand un film vient
+ * d'arriver ou d'être mis à jour.
+ *
+ * Rien n'est montré quand il n'y a rien de neuf, ni quand ça rate : l'écran
+ * « Films partagés » dit où on en est, et permet de relancer.
+ */
+import {useToast} from '@sanity/ui'
+import {useEffect} from 'react'
+import {type LayoutProps, useClient} from 'sanity'
+
+import {API_VERSION as VERSION_API} from '../plugins/planification/types'
+import {annonce, annonceMiseAJour, lancerArrivee} from './arrivee'
+import {ARRIVEE_AUTOMATIQUE, AUTRE, INTERVALLE_ARRIVEE} from './reglages'
+
+function ArriveeDesFilms(): null {
+  const client = useClient({apiVersion: VERSION_API})
+  const toast = useToast()
+
+  useEffect(() => {
+    if (!ARRIVEE_AUTOMATIQUE) return undefined
+    let arrete = false
+    let minuterie: ReturnType<typeof setTimeout> | undefined
+
+    const regarder = async () => {
+      let reessayer = true
+      try {
+        const bilan = await lancerArrivee(client)
+        if (arrete) return
+        if (bilan.arrives.length > 0) {
+          toast.push({
+            status: bilan.imagesManquantes ? 'warning' : 'success',
+            title: annonce(bilan),
+            description: bilan.imagesManquantes
+              ? 'La fiche est dans « Films », mais une image n’a pas suivi : ajoutez-la dans la fiche.'
+              : 'Fiche et affiche sont dans « Films », pas encore à l’affiche. La Planification le propose déjà.',
+            duration: 9000,
+          })
+        }
+        if (bilan.misesAJour.length > 0) {
+          toast.push({
+            status: 'info',
+            title: annonceMiseAJour(bilan),
+            description: `La fiche a été corrigée à ${AUTRE.nom} : la correction est reprise ici. Ce qui est propre à ce cinéma (à l’affiche ou non, séances) n’a pas bougé.`,
+            duration: 9000,
+          })
+        }
+        /* Rien n'a pu être écrit (compte qui ne peut que lire, par exemple) :
+           inutile d'insister toutes les cinq minutes. */
+        if (bilan.rates > 0 && bilan.arrives.length === 0 && bilan.misesAJour.length === 0) reessayer = false
+      } catch (cause) {
+        console.error('Films partagés : l’arrivée automatique a échoué.', cause)
+      }
+      if (!arrete && reessayer) minuterie = setTimeout(regarder, INTERVALLE_ARRIVEE)
+    }
+
+    void regarder()
+    return () => {
+      arrete = true
+      if (minuterie) clearTimeout(minuterie)
+    }
+  }, [client, toast])
+
+  return null
+}
+
+/** Le Studio tel quel, avec l'arrivée des films qui tourne derrière. */
+export function StudioAvecArrivee(props: LayoutProps) {
+  return (
+    <>
+      <ArriveeDesFilms />
+      {props.renderDefault(props)}
+    </>
+  )
+}
diff --git a/sanity/partage/FilmsPartages.tsx b/sanity/partage/FilmsPartages.tsx
new file mode 100644
index 0000000..f4f284a
--- /dev/null
+++ b/sanity/partage/FilmsPartages.tsx
@@ -0,0 +1,357 @@
+/**
+ * Les films partagés : où en est l'arrivée des films de l'autre cinéma.
+ *
+ * Les films arrivent tout seuls, et les corrections aussi (ArriveeDesFilms) ;
+ * cet écran le montre. Une ligne par film de l'autre cinéma : il est ici (et
+ * mène à sa fiche), ou il a été retiré d'ici exprès (et peut être remis), ou
+ * il n'est pas encore arrivé (et peut être demandé tout de suite). Une fiche
+ * modifiée ici n'est jamais écrasée toute seule : la ligne le dit, et un
+ * bouton permet de reprendre celle de l'autre cinéma.
+ */
+import {AddIcon, CheckmarkIcon, EditIcon, SearchIcon, SyncIcon} from '@sanity/icons'
+import {Box, Button, Card, Flex, Spinner, Stack, Text, TextInput, useToast} from '@sanity/ui'
+import {useCallback, useEffect, useMemo, useState} from 'react'
+import {useClient} from 'sanity'
+import {IntentLink} from 'sanity/router'
+
+import {API_VERSION as VERSION_API} from '../plugins/planification/types'
+import {annonce, annonceMiseAJour, autreCinema, lancerArrivee} from './arrivee'
+import {
+  type Ecrivain,
+  type Etat,
+  type FilmDeLaBanque,
+  type FilmDIci,
+  REQUETE_BANQUE,
+  REQUETE_ICI,
+  REQUETE_JOURNAL,
+  comparer,
+  dejaIci,
+  faireVenir,
+  ficheLiee,
+  noterAuJournal,
+  reprendre,
+} from './partage'
+import {AUTRE, ICI, ID_JOURNAL} from './reglages'
+
+/** L'affiche en petit, pour la liste. */
+function vignette(url: string): string {
+  return `${url}?w=96&h=144&fit=crop&auto=format`
+}
+
+export function FilmsPartages() {
+  const client = useClient({apiVersion: VERSION_API})
+  const toast = useToast()
+  const [films, setFilms] = useState<FilmDeLaBanque[] | null>(null)
+  const [ici, setIci] = useState<FilmDIci[]>([])
+  const [journal, setJournal] = useState<string[]>([])
+  const [erreur, setErreur] = useState(false)
+  const [recherche, setRecherche] = useState('')
+  const [enCours, setEnCours] = useState<string | null>(null)
+  const [arrivee, setArrivee] = useState(false)
+
+  /** Relit les deux listes et le carnet. */
+  const lire = useCallback(async () => {
+    const [deLAutre, dIci, notes] = await Promise.all([
+      autreCinema.fetch<FilmDeLaBanque[]>(REQUETE_BANQUE),
+      client.fetch<FilmDIci[]>(REQUETE_ICI, {}, {perspective: 'published'}),
+      client.fetch<string[] | null>(REQUETE_JOURNAL, {id: ID_JOURNAL}, {perspective: 'raw'}),
+    ])
+    setFilms(deLAutre)
+    setIci(dIci)
+    setJournal(notes ?? [])
+  }, [client])
+
+  /** Fait arriver ce qui manque (ou attend l'arrivée déjà en route), puis relit. */
+  const synchroniser = useCallback(
+    async (annoncer: boolean) => {
+      setErreur(false)
+      setArrivee(true)
+      try {
+        const bilan = await lancerArrivee(client).catch((cause: unknown) => {
+          console.error('Films partagés : l’arrivée a échoué.', cause)
+          return null
+        })
+        await lire()
+        if (!annoncer) return
+        if (bilan === null || bilan.rates > 0) {
+          toast.push({
+            status: 'error',
+            title: 'Tous les films n’ont pas pu arriver',
+            description: 'Vérifiez la connexion et réessayez. Rien n’est créé à moitié.',
+          })
+        } else if (bilan.arrives.length > 0 || bilan.misesAJour.length > 0) {
+          if (bilan.arrives.length > 0) toast.push({status: 'success', title: annonce(bilan)})
+          if (bilan.misesAJour.length > 0) toast.push({status: 'success', title: annonceMiseAJour(bilan)})
+        } else {
+          toast.push({status: 'success', title: `Tout est à jour : rien de neuf à ${AUTRE.nom}`})
+        }
+      } catch (cause) {
+        console.error('Films partagés : la liste n’a pas pu être lue.', cause)
+        setErreur(true)
+      } finally {
+        setArrivee(false)
+      }
+    },
+    [client, lire, toast],
+  )
+
+  useEffect(() => {
+    void synchroniser(false)
+  }, [synchroniser])
+
+  const visibles = useMemo(() => {
+    const mots = recherche.trim().toLowerCase()
+    if (!films) return []
+    if (!mots) return films
+    return films.filter((film) =>
+      [film.title, film.director, film.originalTitle].some((champ) => String(champ ?? '').toLowerCase().includes(mots)),
+    )
+  }, [films, recherche])
+
+  /** Fait venir un film à la demande : pas encore arrivé, ou retiré puis regretté. */
+  const prendre = useCallback(
+    async (film: FilmDeLaBanque) => {
+      setEnCours(film._id)
+      try {
+        const {id, imagesManquantes} = await faireVenir(client as unknown as Ecrivain, film)
+        if (!journal.includes(film._id)) {
+          await noterAuJournal(client as unknown as Ecrivain, [film._id]).catch(() => undefined)
+          setJournal((avant) => [...avant, film._id])
+        }
+        setIci((avant) => [...avant, {_id: id, title: film.title, origineBanque: `${AUTRE.cle}:${film._id}`}])
+        await lire().catch(() => undefined)
+        toast.push({
+          status: imagesManquantes ? 'warning' : 'success',
+          title: `« ${film.title ?? 'Film'} » est dans ${ICI}`,
+          description: imagesManquantes
+            ? 'Sa fiche est copiée, mais une image n’a pas suivi : ajoutez-la dans la fiche.'
+            : 'Sa fiche et son affiche sont copiées. Il n’est pas encore à l’affiche : programmez-le dans la Planification.',
+        })
+      } catch (cause) {
+        console.error('Films partagés : le film n’a pas pu venir.', cause)
+        toast.push({
+          status: 'error',
+          title: 'Le film n’a pas pu être copié',
+          description: 'Vérifiez la connexion et réessayez. Rien n’a été créé à moitié.',
+        })
+      } finally {
+        setEnCours(null)
+      }
+    },
+    [client, journal, lire, toast],
+  )
+
+  /** Remplace la description de la fiche d'ici par celle de l'autre cinéma. */
+  const reprendreFiche = useCallback(
+    async (film: FilmDeLaBanque, fiche: FilmDIci, confirmer: boolean) => {
+      if (
+        confirmer &&
+        !window.confirm(
+          `Remplacer la fiche de ${ICI} par celle de ${AUTRE.nom} ?\n\nLe titre, le synopsis, l’affiche et les autres informations du film seront ceux de ${AUTRE.nom}. Ce qui est propre à ${ICI} (à l’affiche ou non, séances) ne change pas.`,
+        )
+      ) {
+        return
+      }
+      setEnCours(film._id)
+      try {
+        const {imagesManquantes} = await reprendre(client as unknown as Ecrivain, film, fiche)
+        await lire().catch(() => undefined)
+        toast.push({
+          status: imagesManquantes ? 'warning' : 'success',
+          title: `« ${film.title ?? 'Film'} » : fiche mise à jour d’après ${AUTRE.nom}`,
+          description: imagesManquantes ? 'Une image n’a pas suivi : l’ancienne est restée.' : undefined,
+        })
+      } catch (cause) {
+        console.error('Films partagés : la fiche n’a pas pu être reprise.', cause)
+        toast.push({status: 'error', title: 'La fiche n’a pas pu être mise à jour', description: 'Vérifiez la connexion et réessayez.'})
+      } finally {
+        setEnCours(null)
+      }
+    },
+    [client, lire, toast],
+  )
+
+  /** Où en est chaque fiche liée, pour la ligne d'état et pour les lignes. */
+  const etats = useMemo(() => {
+    const parFilm = new Map<string, {fiche: FilmDIci; etat: Etat}>()
+    for (const film of films ?? []) {
+      const fiche = ficheLiee(film, ici)
+      if (fiche) parFilm.set(film._id, {fiche, etat: comparer(film, fiche)})
+    }
+    return parFilm
+  }, [films, ici])
+
+  const aChoisir = useMemo(
+    () => [...etats.values()].filter(({etat}) => etat === 'differente' || etat === 'modifiee-ici').length,
+    [etats],
+  )
+
+  const manquants = useMemo(
+    () => (films ?? []).filter((film) => !dejaIci(film, ici) && !journal.includes(film._id)).length,
+    [films, ici, journal],
+  )
+
+  return (
+    <Box padding={4} style={{height: '100%', overflow: 'auto'}}>
+      <Stack space={4}>
+        <Stack space={3}>
+          <Text size={2} weight="semibold">
+            Films partagés avec {AUTRE.nom}
+          </Text>
+          <Text size={1} muted>
+            Un film créé à {AUTRE.nom} arrive ici tout seul, fiche et affiche comprises : rien à retaper, rien à
+            cliquer. Il est alors dans « Films » et dans la Planification, mais pas encore à l’affiche : c’est ici
+            qu’on décide de le montrer. Une fiche corrigée à {AUTRE.nom} est corrigée ici aussi, toute seule, tant
+            qu’elle n’a pas été modifiée à {ICI} entre-temps.
+          </Text>
+          {films !== null && !erreur && (
+            <Text size={1} weight="medium" data-etat-du-partage>
+              {arrivee
+                ? `Arrivée des films de ${AUTRE.nom} en cours…`
+                : manquants === 0
+                  ? `À jour : les ${films.length} films de ${AUTRE.nom} sont connus de ${ICI}.`
+                  : `${manquants} film${manquants > 1 ? 's' : ''} de ${AUTRE.nom} ${manquants > 1 ? 'ne sont' : 'n’est'} pas encore arrivé${manquants > 1 ? 's' : ''}.`}
+              {!arrivee && aChoisir > 0
+                ? ` ${aChoisir} fiche${aChoisir > 1 ? 's ne sont pas les mêmes' : ' n’est pas la même'} dans les deux cinémas : elle${aChoisir > 1 ? 's sont' : ' est'} laissée${aChoisir > 1 ? 's' : ''} telle${aChoisir > 1 ? 's' : ''} quelle${aChoisir > 1 ? 's' : ''}.`
+                : ''}
+            </Text>
+          )}
+        </Stack>
+
+        <Flex gap={2}>
+          <Box flex={1}>
+            <TextInput
+              icon={SearchIcon}
+              placeholder="Chercher un titre ou une réalisation"
+              value={recherche}
+              onChange={(evenement) => setRecherche(evenement.currentTarget.value)}
+            />
+          </Box>
+          <Button
+            icon={SyncIcon}
+            mode="ghost"
+            text="Synchroniser"
+            loading={arrivee}
+            disabled={arrivee}
+            onClick={() => void synchroniser(true)}
+          />
+        </Flex>
+
+        {erreur && (
+          <Card padding={4} tone="critical" border radius={2}>
+            <Flex align="center" justify="space-between" gap={3}>
+              <Text size={1}>Les films de {AUTRE.nom} n’ont pas pu être lus. Vérifiez la connexion.</Text>
+              <Button text="Réessayer" onClick={() => void synchroniser(true)} />
+            </Flex>
+          </Card>
+        )}
+        {!erreur && films === null && (
+          <Flex align="center" gap={3} padding={4}>
+            <Spinner muted />
+            <Text muted>Lecture des films de {AUTRE.nom}…</Text>
+          </Flex>
+        )}
+        {films !== null && visibles.length === 0 && (
+          <Text size={1} muted>
+            {films.length === 0 ? `${AUTRE.nom} n’a encore publié aucun film.` : 'Aucun film ne correspond à cette recherche.'}
+          </Text>
+        )}
+
+        <Stack space={2}>
+          {visibles.map((film) => {
+            const present = dejaIci(film, ici)
+            const retire = !present && journal.includes(film._id)
+            const lien = etats.get(film._id)
+            const etat = lien?.etat ?? null
+            const aReprendre = etat === 'a-reprendre'
+            const autreVersion = etat === 'differente' || etat === 'modifiee-ici'
+            return (
+              <Card key={film._id} border radius={2} padding={2} data-film-de-la-banque={film._id}>
+                <Flex align="center" gap={3}>
+                  <Box style={{width: 48, height: 72, background: '#e6e6e6', flexShrink: 0}}>
+                    {film.affiche?.url && (
+                      <img
+                        src={vignette(film.affiche.url)}
+                        alt=""
+                        width={48}
+                        height={72}
+                        loading="lazy"
+                        style={{display: 'block', width: 48, height: 72, objectFit: 'cover'}}
+                      />
+                    )}
+                  </Box>
+                  <Box flex={1}>
+                    <Stack space={2}>
+                      <Text size={1} weight="semibold">
+                        {film.title ?? 'Film sans titre'}
+                      </Text>
+                      <Text size={1} muted>
+                        {[film.director, film.year, film.duration ? `${film.duration} min` : null].filter(Boolean).join(' · ') ||
+                          'Fiche incomplète'}
+                      </Text>
+                    </Stack>
+                  </Box>
+                  {present ? (
+                    <Flex align="center" gap={2}>
+                      <Flex align="center" gap={1}>
+                        <Text size={1} muted>
+                          <CheckmarkIcon />
+                        </Text>
+                        <Text size={1} muted>
+                          {aReprendre
+                            ? `Corrigée à ${AUTRE.nom}`
+                            : etat === 'modifiee-ici'
+                              ? `Modifiée à ${ICI}`
+                              : etat === 'differente'
+                                ? 'Fiche différente'
+                                : `Dans ${ICI}`}
+                        </Text>
+                      </Flex>
+                      {lien && (aReprendre || autreVersion) && (
+                        <Button
+                          icon={SyncIcon}
+                          mode={aReprendre ? 'default' : 'ghost'}
+                          tone={aReprendre ? 'primary' : 'default'}
+                          fontSize={1}
+                          padding={2}
+                          text={aReprendre ? 'Mettre à jour' : `Reprendre la fiche de ${AUTRE.nom}`}
+                          loading={enCours === film._id}
+                          disabled={enCours !== null || arrivee}
+                          onClick={() => void reprendreFiche(film, lien.fiche, autreVersion)}
+                        />
+                      )}
+                      <Button
+                        as={IntentLink}
+                        {...{intent: 'edit', params: {id: present._id, type: 'film'}}}
+                        icon={EditIcon}
+                        mode="bleed"
+                        fontSize={1}
+                        padding={2}
+                        text="Ouvrir"
+                      />
+                    </Flex>
+                  ) : (
+                    <Flex align="center" gap={2}>
+                      <Text size={1} muted>
+                        {retire ? `Retiré de ${ICI}` : 'Pas encore arrivé'}
+                      </Text>
+                      <Button
+                        icon={AddIcon}
+                        mode={retire ? 'ghost' : 'default'}
+                        tone={retire ? 'default' : 'primary'}
+                        text={retire ? 'Remettre' : 'Faire venir'}
+                        loading={enCours === film._id}
+                        disabled={enCours !== null || arrivee}
+                        onClick={() => prendre(film)}
+                      />
+                    </Flex>
+                  )}
+                </Flex>
+              </Card>
+            )
+          })}
+        </Stack>
+      </Stack>
+    </Box>
+  )
+}
